{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/scorecard.v2.schema.json",
  "title": "Scorecard v2 frontmatter model",
  "type": "object",
  "required": ["schema_version", "date", "task_id", "run_id", "orchestrator", "verified_by", "grade", "outcome", "workers"],
  "properties": {
    "schema_version": {"const": "scorecard.v2"},
    "verified_by": {"enum": ["self-verified", "cross-verified", "human-verified"]},
    "workers": {"type": "array", "minItems": 1}
  }
}
