{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/routing_decision.v1.schema.json",
  "title": "Advisory routing decision",
  "type": "object",
  "required": ["schema_version", "task_id", "status", "recommended_alias", "selected_alias", "actual_alias", "eligible_aliases", "authority"],
  "properties": {
    "schema_version": {"const": "routing_decision.v1"},
    "task_id": {"type": ["string", "null"]},
    "status": {"enum": ["ROUTE_RECOMMENDED", "HUMAN_REVIEW_REQUIRED"]},
    "risk_level": {"type": "string"},
    "recommended_alias": {"type": ["string", "null"]},
    "selected_alias": {"type": "null"},
    "actual_alias": {"type": "null"},
    "eligible_aliases": {"type": "array", "items": {"type": "string"}},
    "authority": {"const": "advisory-only"}
  }
}
