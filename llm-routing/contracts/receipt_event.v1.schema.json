{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/receipt_event.v1.schema.json",
  "title": "Execution or verification receipt",
  "oneOf": [
    {
      "type": "object",
      "required": ["event_type", "trace_id", "worker_alias", "outcome"],
      "properties": {"event_type": {"const": "ExecutionReceipt"}}
    },
    {
      "type": "object",
      "required": ["event_type", "trace_id", "verification_status", "verification_level"],
      "properties": {
        "event_type": {"const": "VerificationReceipt"},
        "verification_status": {"enum": ["pass", "fail", "pending"]},
        "verification_level": {"enum": ["self-verified", "cross-verified", "human-verified"]}
      }
    }
  ]
}
